    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:; frame-src 'self' https://www.tiktok.com https://*.tiktok.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.tiktok.com https://www.googletagmanager.com https://fonts.googleapis.com; img-src 'self' data: https: blob:; connect-src 'self' https:;"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
